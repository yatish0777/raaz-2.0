# Local LLM for AI report drafting (https://ollama.com)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.1:8b

# Live TRON tracing (/api/trace). Server-side only: no VITE_ prefix, so they never reach the browser.
# On Vercel set these in Project → Settings → Environment Variables.
TRONGRID_API_KEY=
# Optional: adds Tronscan's public exchange tags to the built-in exchange list
TRONSCAN_API_KEY=
